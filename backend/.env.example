# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# JWT Configuration
JWT_SECRET_KEY=your_secret_key_min_32_characters_long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:8443","http://localhost:3000","http://localhost:5173","http://127.0.0.1:8443","http://127.0.0.1:5173"]

# AWS Configuration (India - ap-south-1 Mumbai)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=cliniq-documents-mumbai
AWS_BEDROCK_MODEL_ID=meta.llama3-70b-instruct-v1:0
AWS_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
